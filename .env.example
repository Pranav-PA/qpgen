# --- OpenAI (server-side only) ---
OPENAI_API_KEY=
# Optional model overrides (defaults: gpt-5.6-terra for generation, gpt-5.6-luna for verification)
OPENAI_GENERATION_MODEL=
OPENAI_VERIFIER_MODEL=

# --- Supabase ---
# Project URL and anon key are safe for the browser (RLS is the security boundary).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-side only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Abuse protection (optional but recommended for public deploys) ---
# Cloudflare Turnstile keys; leave blank to disable the signup captcha in local dev.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Local development ---
# Set to "true" to run without an OpenAI key: generation returns realistic mock
# questions so the full UI flow can be exercised at zero cost.
MOCK_AI=
