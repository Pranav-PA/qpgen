# --- AI providers (server-side only) ---
# Which backend to use when the admin panel has not chosen one: google | openai
AI_PROVIDER=google

# Google Gemini — the default provider.
GOOGLE_API_KEY=
# Optional overrides (defaults: gemini-3.6-flash / gemini-3.5-flash-lite)
GEMINI_GENERATION_MODEL=
GEMINI_VERIFIER_MODEL=

# OpenAI — kept as the switchable alternative.
OPENAI_API_KEY=
# Optional model overrides (defaults: gpt-5.6-terra for generation, gpt-5.6-luna for verification)
OPENAI_GENERATION_MODEL=
OPENAI_VERIFIER_MODEL=

# --- Supabase ---
# Project URL and anon key are safe for the browser (RLS is the security boundary).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-side only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Abuse protection (optional but recommended for public deploys) ---
# Cloudflare Turnstile keys; leave blank to disable the signup captcha in local dev.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Local development ---
# Set to "true" to run without any AI key: generation returns realistic mock
# questions so the full UI flow can be exercised at zero cost.
MOCK_AI=
